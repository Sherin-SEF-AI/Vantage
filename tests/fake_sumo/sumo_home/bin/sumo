#!/usr/bin/env python3
"""A fake SUMO server: listens on --remote-port, sends its command line (JSON, one line) to the first client and holds
the connection until the client closes it (then exits 0). The simulation itself runs in the fake traci. With
FAKE_SUMO_FAIL set it exits at once with an error (a SUMO that cannot start)."""
import json
import os
import signal
import socket
import sys

if os.environ.get('FAKE_SUMO_FAIL'):
    print('Error: fake SUMO told to fail', flush=True)
    sys.exit(1)
signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
argv = sys.argv
port = int(argv[argv.index('--remote-port') + 1])
srv = socket.socket()
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(('127.0.0.1', port))
srv.listen(1)
print(f'fake SUMO listening on {port}', flush=True)
conn, _ = srv.accept()
conn.sendall((json.dumps(argv) + '\n').encode())
while True:
    d = conn.recv(65536)
    if not d:
        break
    if b'x' in d:                                   # the fake traci asks it to crash
        print('Segmentation fault (fake)', flush=True)
        os._exit(139)
print('fake SUMO: the client closed the connection', flush=True)
